# Database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docdb

# Database connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# DeepSeek LLM configuration (OpenAI-compatible)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Embedding model info (optional metadata for UI)
EMBEDDING_MODEL=none (skipped)

# Storage directory for uploaded documents
UPLOAD_DIR=uploads

# Maximum document upload size in bytes (default 25MB = 26214400)
MAX_UPLOAD_SIZE_BYTES=26214400

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
